{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "rrs:thruster_effect",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.particle_line": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = Math.random(0.1, 0.2);"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.5,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(variable.particle_random_1 * 2) + 3"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "variable.particle_random_3*360",
				"rotation_rate": "math.sin(variable.particle_random_3*720)*300"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_motion_parametric": {
				"rotation": "variable.particle_random_3*360"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["56-math.round(variable.particle_line * 7)*8", 96],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [0.07843, 0.81961, 0.25882, 1]
			}
		}
	}
}