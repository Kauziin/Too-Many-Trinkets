{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "rrs:golden_feather_particles",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/golden_feather"
			}
		},
		"curves": {
			"variable.time": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 8,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.5, 0],
				"radius": 0.5,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.5 + variable.particle_random_3"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_motion_parametric": {
				"rotation": "variable.particle_random_1*360"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.05 + variable.particle_random_1 * 0.2", "0.05 + variable.particle_random_1 * 0.2"],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.001
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 48,
					"uv": ["Math.sin(variable.particle_random_4*360) > 0 ? 8 : 0", "(Math.cos(variable.particle_random_4*360) > 0 ? 8 : 0) + Math.round(variable.time * 2) * 16"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_2",
					"gradient": {
						"0.0": "#ffffffff",
						"0.4": "#FFFFE1B9",
						"1.0": "#FFFFCACA"
					}
				}
			}
		}
	}
}